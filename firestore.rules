rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Secure update rule for connections/friends arrays
      allow update: if request.auth != null 
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receivedRequests', 'friends', 'sentRequests'])
        // Ensure that a user can only add or remove their OWN uid from another user's arrays
        && (
             (!('receivedRequests' in request.resource.data) || 
              request.resource.data.receivedRequests.toSet().difference(resource.data.receivedRequests.toSet()).hasOnly([request.auth.uid]) ||
              resource.data.receivedRequests.toSet().difference(request.resource.data.receivedRequests.toSet()).hasOnly([request.auth.uid]))
             &&
             (!('friends' in request.resource.data) || 
              request.resource.data.friends.toSet().difference(resource.data.friends.toSet()).hasOnly([request.auth.uid]) ||
              resource.data.friends.toSet().difference(request.resource.data.friends.toSet()).hasOnly([request.auth.uid]))
             &&
             (!('sentRequests' in request.resource.data) || 
              request.resource.data.sentRequests.toSet().difference(resource.data.sentRequests.toSet()).hasOnly([request.auth.uid]) ||
              resource.data.sentRequests.toSet().difference(request.resource.data.sentRequests.toSet()).hasOnly([request.auth.uid]))
           );
    }
    
    // Explicit friends subcollection rule for bi-directional relationships
    match /users/{userId}/friends/{friendId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == friendId);
    }
    
    match /alerts/{alertId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.senderId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.friends
      );
      allow create: if request.auth != null && request.resource.data.senderId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.senderId == request.auth.uid;
    }
    
    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
