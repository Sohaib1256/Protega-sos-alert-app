rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow other users to modify ONLY friend-handshake arrays
      allow update: if request.auth != null 
                    && request.auth.uid != userId 
                    && request.resource.data.diff(resource.data)
                       .affectedKeys()
                       .hasOnly(['receivedRequests', 'sentRequests']);
    }

    match /users/{userId}/friends/{friendId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                   && (request.auth.uid == userId || request.auth.uid == friendId);
    }

    match /alerts/{alertId} {
      allow create, read: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.senderId;
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read, update, delete: if request.auth != null 
                                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null 
                    && request.auth.uid in request.resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth != null 
                           && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
